{
  "name": "Renofine",
  "short_name": "Renofine",
  "description": "Planera, driv och följ upp din renovering — med Renaida som hjälp.",
  "start_url": "/start",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FAFAF7",
  "theme_color": "#1A1A17",
  "icons": [
    { "src": "/brand/png/app-icons/app-icon-paper-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/png/app-icons/app-icon-paper-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/brand/png/app-icons/app-icon-paper-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*", "application/pdf"] }]
    }
  },
  "shortcuts": [
    {
      "name": "Fota kvitto",
      "url": "/capture?intent=receipt",
      "icons": [{ "src": "/brand/png/app-icons/app-icon-paper-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Berätta för Renaida",
      "url": "/capture?intent=voice",
      "icons": [{ "src": "/brand/png/app-icons/app-icon-paper-192.png", "sizes": "192x192" }]
    }
  ]
}
